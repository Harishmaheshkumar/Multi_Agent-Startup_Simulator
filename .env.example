# Multi-Agent Startup Simulator Configuration
# Copy this file to .env and fill in your values

# LLM Configuration
# Groq API Key (get from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Ollama Configuration (local LLM, alternative to Groq)
OLLAMA_BASE_URL=http://localhost:11434

# Anthropic API Key (not yet implemented)
# ANTHROPIC_API_KEY=your_anthropic_key_here

# LLM Settings
MAX_TOKENS=4096
TEMPERATURE=0.7

# Memory Configuration
# Set to true to enable Redis persistence (requires Redis running on localhost:6379)
USE_REDIS=false
REDIS_URL=redis://localhost:6379

# Vector Store Configuration
VECTOR_DIMENSION=384
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# UI Configuration
UI_PORT=8501
RUN_UI=true

# Simulation Configuration
RUN_SIMULATION=true
SIMULATION_INTERVAL=30

# CrewAI Configuration
MAX_ITERATIONS=10
VERBOSE=true

# Application Configuration
DEBUG=false
LOG_LEVEL=INFO
